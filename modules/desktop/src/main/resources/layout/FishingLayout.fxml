<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="Infinity" maxWidth="Infinity"
      HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="task-page-scroll"
                    vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
            <content>
                <VBox styleClass="task-page-root" maxHeight="Infinity"
                      maxWidth="Infinity">
                    <children>

                        <!-- Fishing Minigame Card -->
                        <VBox styleClass="content-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity"
                                      styleClass="header-teal">
                                    <children>
                                        <Label text="Fishing Minigame Control" />
                                    </children>
                                </HBox>
                                <VBox styleClass="task-section-inner">
                                    <children>
                                        <Label styleClass="task-card-description"
                                               text="Uses available ordinary bait. Dodges on descent and seeks a full haul on return. Unknown screens stop the session without purchases."
                                               wrapText="true" />

                                        <Separator style="-fx-opacity: 0.25;" />

                                        <CheckBox fx:id="checkBoxEnableFishing" mnemonicParsing="false"
                                                  text="Enable Fishing Minigame Task" />
                                        <HBox alignment="CENTER_LEFT" spacing="12">
                                            <Label text="Maximum casts per session (1–10)" />
                                            <TextField fx:id="textFieldMaxCasts" prefWidth="80"
                                                       maxWidth="100" promptText="Maximum casts" />
                                        </HBox>
                                        <Label wrapText="true" styleClass="task-card-description"
                                               text="Out-of-range cast limits allow only one cast. A full haul also counts as success even when descent ends early." />
                                        <HBox alignment="CENTER_LEFT" spacing="12">
                                            <Label text="Target catches (1–100; limited by hook capacity)" />
                                            <TextField fx:id="textFieldTargetCatches" prefWidth="80" maxWidth="100" />
                                        </HBox>
                                        <CheckBox fx:id="checkBoxRestartShortHaul" text="Retry a short haul before reaching the surface" />
                                        <HBox alignment="CENTER_LEFT" spacing="12">
                                            <Label text="Maximum same-bait restarts (0–10)" />
                                            <TextField fx:id="textFieldMaxRestarts" prefWidth="80" maxWidth="100" />
                                        </HBox>
                                        <CheckBox fx:id="checkBoxDarkCorner" text="Hold a random corner when vision is lost without a Lantern" />
                                        <Separator style="-fx-opacity: 0.25;" />
                                        <HBox alignment="CENTER_LEFT" spacing="12">
                                            <Label text="Maximum casts with special items (0–10)" />
                                            <TextField fx:id="textFieldMaxSpecialCasts" prefWidth="80" maxWidth="100" />
                                        </HBox>
                                        <CheckBox fx:id="checkBoxUseLantern" text="Use a Lantern for deep-water visibility" />
                                        <CheckBox fx:id="checkBoxUseStabilizer" text="Use a Reel Stabilizer for two extra protections" />
                                        <CheckBox fx:id="checkBoxRequireSpecialItems" text="Stop rather than cast without the selected special items" />
                                        <Label wrapText="true" styleClass="task-card-description"
                                               text="Items default off. After the boosted-cast limit, continue without items unless Stop is selected. Same-bait retries do not select another loadout. Horn targeting and Ocean Scanner guidance are not automated yet." />
                                        <Label wrapText="true" styleClass="task-card-description"
                                               text="Retries reuse the existing paid stage, never select new bait. Invalid restart limits disable retries. Gem purchases are not enabled in this version." />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Test Hook Loop Card -->
                        <VBox styleClass="content-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" maxWidth="Infinity"
                                      styleClass="header-blue">
                                    <children>
                                        <Label text="Test Hook Loop" />
                                    </children>
                                </HBox>
                                <VBox styleClass="task-section-inner">
                                    <children>
                                        <Label styleClass="task-card-description"
                                               text="Captures every frame from the emulator and searches for the fishing hook template. Logs hook coordinates and per-frame ADB vs OpenCV timing to the Logs UI."
                                               wrapText="true" />

                                        <Separator style="-fx-opacity: 0.25;" />

                                        <CheckBox fx:id="checkBoxEnableTestHookLoop" mnemonicParsing="false"
                                                  text="Enable Test Hook Loop" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
