<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="task-workbench-root" stylesheets="@taskworkbench.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox>
            <VBox spacing="7" styleClass="workbench-toolbar">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Task Workbench" styleClass="workbench-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="capabilityLabel" text="No task selected"
                           styleClass="workbench-capability" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="6" styleClass="workbench-control-row">
                    <ComboBox fx:id="profileComboBox" maxWidth="260" minWidth="120" prefWidth="230"
                              promptText="Profile" styleClass="workbench-combo" HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="taskComboBox" maxWidth="300" minWidth="120" prefWidth="260"
                              promptText="Task" styleClass="workbench-combo" HBox.hgrow="ALWAYS" />
                    <Region minWidth="4" prefWidth="10" />
                    <Button fx:id="runButton" onAction="#handleRun" styleClass="workbench-action-button" />
                    <Button fx:id="pauseButton" onAction="#handlePause" styleClass="workbench-action-button" />
                    <Button fx:id="nextButton" onAction="#handleNext" styleClass="workbench-action-button" />
                    <Button fx:id="resumeButton" onAction="#handleResume" styleClass="workbench-action-button" />
                    <Button fx:id="stopButton" onAction="#handleStop"
                            styleClass="workbench-action-button, workbench-stop-button" />
                </HBox>
                <padding><Insets bottom="10" left="16" right="16" top="10" /></padding>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="24" styleClass="workbench-status-band">
                <VBox maxWidth="Infinity" minWidth="0" spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="CURRENT STEP" styleClass="workbench-field-label" />
                    <Label fx:id="currentStepLabel" maxWidth="Infinity" text="None"
                           styleClass="workbench-step-value" wrapText="true" />
                </VBox>
                <VBox maxWidth="Infinity" minWidth="0" spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="LAST STEP" styleClass="workbench-field-label" />
                    <Label fx:id="lastStepLabel" maxWidth="Infinity" text="None"
                           styleClass="workbench-step-value" wrapText="true" />
                </VBox>
                <VBox alignment="CENTER_RIGHT" minWidth="150" spacing="4">
                    <Label text="EXECUTION" styleClass="workbench-field-label" />
                    <Label fx:id="stateLabel" text="IDLE"
                           styleClass="workbench-state, workbench-state-idle" />
                </VBox>
                <padding><Insets bottom="14" left="18" right="18" top="14" /></padding>
            </HBox>
            <Label fx:id="messageLabel" managed="false" visible="false"
                   styleClass="workbench-message" wrapText="true">
                <padding><Insets bottom="8" left="18" right="18" top="8" /></padding>
            </Label>
        </VBox>
    </top>
    <center>
        <VBox spacing="8">
            <Label text="EXECUTION HISTORY" styleClass="workbench-section-title" />
            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" styleClass="workbench-history">
                <columns>
                    <TableColumn fx:id="timeColumn" minWidth="110" prefWidth="130" text="Time" />
                    <TableColumn fx:id="stepColumn" minWidth="280" prefWidth="540" text="Step" />
                    <TableColumn fx:id="statusColumn" minWidth="130" prefWidth="170" text="Status" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                </columnResizePolicy>
            </TableView>
            <padding><Insets bottom="16" left="18" right="18" top="14" /></padding>
        </VBox>
    </center>
</BorderPane>
