<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="task-workbench-root" stylesheets="@taskworkbench.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox>
            <VBox spacing="7" styleClass="workbench-toolbar">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Task Workbench" styleClass="workbench-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="capabilityLabel" text="No task selected"
                           styleClass="workbench-capability" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="6" styleClass="workbench-control-row">
                    <ComboBox fx:id="profileComboBox" maxWidth="250" minWidth="120" prefWidth="220"
                              promptText="Profile" styleClass="workbench-combo" HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="taskComboBox" maxWidth="280" minWidth="120" prefWidth="245"
                              promptText="Task" styleClass="workbench-combo" HBox.hgrow="ALWAYS" />
                    <Button fx:id="loadButton" onAction="#handleLoad"
                            styleClass="workbench-load-button" />
                    <Region minWidth="4" prefWidth="10" />
                    <Label fx:id="stateLabel" text="IDLE"
                           styleClass="workbench-state, workbench-state-idle" />
                    <Button fx:id="pauseButton" onAction="#handlePause" styleClass="workbench-action-button" />
                    <Button fx:id="nextButton" onAction="#handleNext" styleClass="workbench-action-button" />
                    <Button fx:id="resumeButton" onAction="#handleResume" styleClass="workbench-action-button" />
                    <Button fx:id="stopButton" onAction="#handleStop"
                            styleClass="workbench-action-button, workbench-stop-button" />
                </HBox>
                <padding><Insets bottom="10" left="16" right="16" top="10" /></padding>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="24" styleClass="workbench-status-band">
                <VBox maxWidth="Infinity" minWidth="0" spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="LAST STEP" styleClass="workbench-field-label" />
                    <Label fx:id="lastStepLabel" maxWidth="Infinity" text="None"
                           styleClass="workbench-step-value" wrapText="true" />
                </VBox>
                <VBox maxWidth="Infinity" minWidth="0" spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="CURRENT STEP" styleClass="workbench-field-label" />
                    <Label fx:id="currentStepLabel" maxWidth="Infinity" text="None"
                           styleClass="workbench-step-value" wrapText="true" />
                </VBox>
                <VBox maxWidth="Infinity" minWidth="0" spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="NEXT STEP" styleClass="workbench-field-label" />
                    <Label fx:id="nextStepLabel" maxWidth="Infinity" text="None"
                           styleClass="workbench-step-value" wrapText="true" />
                </VBox>
                <padding><Insets bottom="12" left="18" right="18" top="12" /></padding>
            </HBox>
            <Label fx:id="messageLabel" managed="false" visible="false"
                   styleClass="workbench-message" wrapText="true">
                <padding><Insets bottom="8" left="18" right="18" top="8" /></padding>
            </Label>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.62" orientation="VERTICAL" styleClass="workbench-split">
            <VBox minHeight="210" spacing="7" styleClass="workbench-section">
                <Label text="TASK FLOW" styleClass="workbench-section-title" />
                <ScrollPane fitToHeight="false" fitToWidth="true" pannable="true"
                            VBox.vgrow="ALWAYS" styleClass="workbench-graph-scroll">
                    <content>
                        <Pane fx:id="graphPane" minWidth="900" />
                    </content>
                </ScrollPane>
            </VBox>
            <VBox minHeight="150" spacing="7" styleClass="workbench-section">
                <Label text="TASK LOGS" styleClass="workbench-section-title" />
                <TableView fx:id="logTable" VBox.vgrow="ALWAYS" styleClass="workbench-log-table">
                    <columns>
                        <TableColumn fx:id="logTimeColumn" minWidth="100" prefWidth="115" text="Time" />
                        <TableColumn fx:id="logLevelColumn" minWidth="85" prefWidth="100" text="State / Level" />
                        <TableColumn fx:id="logSourceColumn" minWidth="90" prefWidth="125" text="Source" />
                        <TableColumn fx:id="logMessageColumn" minWidth="280" prefWidth="620" text="Message" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
