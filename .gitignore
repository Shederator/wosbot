# ── Maven build output ──
target/
.frostguard-dev/
**/target/
dependency-reduced-pom.xml

# ── Binaries / compiled artifacts ──
*.jar
*.war
*.ear
*.class

# Runtime-extracted native libraries (regenerated on launch from the classpath)
**/lib/opencv/

# ── Logs ──
*.log
/log/
**/log/

# ── Databases (SQLite runtime files) ──
*.db*
database.db-shm
database.db-wal

# ── Environment configs ──
.env*

# Local agent workflow
AGENTS.local.md
TODO.md
.claude/settings.local.json

# ── IDEs ──
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.vscode/
.nb-gradle/
.metadata/
nbproject/private/
modules/*/bin
modules/*/.settings

# ── Analysis / misc caches ──
.scannerwork/
.cache/
__pycache__/
*.py[cod]

# ── OS generated files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.bak
*.swp
*~

# Python bytecode from the CI helper scripts
ci/__pycache__/
build-support/**/__pycache__/

# Rewritten at runtime by CustomTaskService with absolute machine-specific
# source paths - tracking it produces constant spurious diffs.
custom_tasks/custom_tasks.json

# Runtime telemetry output - machine-specific, regenerated every run.
telemetry/

# ── Live-debug screenshot dumps (throwaway diagnostic artifacts, not source) ──
/*.png
/shop-debug/
/monument_trace/
/labyrinth-debug/*.png
/labyrinth-debug/auto/_frames/*.png

# ── Compressed rotated logs ──
/logs/*.gz

# ── Runtime settings snapshots (regenerated hourly, machine-specific) ──
/settings-backups/
