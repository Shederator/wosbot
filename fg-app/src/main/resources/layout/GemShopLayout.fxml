<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Gem Shop — matt/2026-08-13: the top-right cart-icon panel, split out of the old combined
     "Shop" page so it's never confused with the bottom-nav "General Shop" (Nomadic Merchant /
     Mystery Shop, a completely different feature). -->
<StackPane maxHeight="Infinity" maxWidth="Infinity"
           HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
           xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                styleClass="task-page-scroll">
        <VBox spacing="14" styleClass="task-page-root" maxWidth="Infinity">

            <!-- Custom Armament Chest -->
            <VBox styleClass="content-card">
                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="header-yellow">
                    <Label text="Custom Armament Chest" />
                </HBox>
                <VBox spacing="10" styleClass="task-section-inner">
                    <Label styleClass="task-card-description"
                           text="Rotating, periodic event (may not appear for weeks) -- claims only the free 'Claimable' chest badge, never the paid chest packs. Checked once a day."
                           wrapText="true" />
                    <Separator style="-fx-opacity: 0.25;" />
                    <CheckBox fx:id="checkBoxCustomArmamentChest" mnemonicParsing="false"
                              text="Claim free chest badge" />
                </VBox>
            </VBox>

            <!-- Daily Deals -->
            <VBox styleClass="content-card">
                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="header-yellow">
                    <Label text="Daily Deals" />
                </HBox>
                <VBox spacing="10" styleClass="task-section-inner">
                    <Label styleClass="task-card-description"
                           text="A genuinely free chest badge once a day -- everything else on this tab is a paid pack. Checked once a day."
                           wrapText="true" />
                    <Separator style="-fx-opacity: 0.25;" />
                    <CheckBox fx:id="checkBoxDailyDealsFreeChest" mnemonicParsing="false"
                              text="Claim free chest badge" />
                </VBox>
            </VBox>

        </VBox>
    </ScrollPane>
</StackPane>
